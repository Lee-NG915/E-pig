{
  "name": "e-pig",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/require-market.mjs next dev",
    "dev:au": "MARKET=au next dev",
    "dev:sg": "MARKET=sg next dev",
    "dev:us": "MARKET=us next dev",
    "build": "MARKET=${MARKET:-au} next build",
    "prestart": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/require-market.mjs node .next/standalone/server.js",
    "lint": "MARKET=${MARKET:-au} eslint .",
    "typecheck": "MARKET=${MARKET:-au} tsc --noEmit",
    "test": "MARKET=${MARKET:-au} vitest run",
    "test:watch": "MARKET=${MARKET:-au} vitest",
    "test:harness-evals": "node scripts/quality/run-post-edit-evals.mjs && node scripts/quality/run-stop-review-evals.mjs && node scripts/quality/run-boundary-evals.mjs",
    "quality:diff": "bash scripts/quality/diff-check.sh",
    "quality:companions": "node scripts/quality/check-component-companions.mjs",
    "docs:check": "node scripts/quality/check-doc-sync.mjs",
    "verify": "pnpm docs:check && pnpm typecheck && pnpm lint && pnpm test && pnpm happy-dog:test && pnpm test:harness-evals && pnpm agent-doctor",
    "agent-doctor": "node scripts/e-pig-doctor.mjs",
    "smoke:runtime-market": "node scripts/smoke/runtime-market.mjs",
    "storybook": "pnpm --filter @e-pig/happy-dog storybook",
    "build-storybook": "pnpm --filter @e-pig/happy-dog build-storybook",
    "storybook:modules": "pnpm --filter @e-pig/storybook-host storybook",
    "build-storybook:modules": "pnpm --filter @e-pig/storybook-host build-storybook",
    "happy-dog:test": "pnpm --filter @e-pig/happy-dog test",
    "catalog:fetch-koala": "node scripts/catalog/fetch-koala-fixtures.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bash scripts/deploy-cf.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@e-pig/happy-dog": "workspace:*",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-slot": "1.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
