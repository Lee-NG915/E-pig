{
  "name": "@e-pig/happy-dog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles/globals.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./theme": "./src/theme/index.ts"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#theme/*": "./src/theme/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.9",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-radio-group": "1.4.5",
    "@radix-ui/react-select": "2.3.5",
    "@radix-ui/react-separator": "1.1.13",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.5",
    "@radix-ui/react-tabs": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^29.1.1",
    "storybook": "^10.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "latest",
    "vitest": "^4.1.10"
  }
