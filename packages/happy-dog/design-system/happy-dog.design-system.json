  "implementationContract": {
    "do": [
      "Update packages/happy-dog theme CSS variables to match semantic + primitives above (oklch preferred for runtime; keep hex mapping documented)",
      "Implement missing components with shadcn/Radix patterns already used by button/badge/sheet",
      "Co-locate *.stories.tsx for every public component; cover variants from this manifest",
      "Export new components from package public API",
      "Keep modules importing only from @e-pig/happy-dog — no Figma dump paths",
      "Add/adjust Vitest specs for pure variant logic where meaningful; stories are the visual contract"
    ],
    "dont": [
      "Do not paste Figma MCP-generated React/Tailwind as production components",
      "Do not introduce purple/indigo AI-slop palettes or pure #000",
      "Do not put product-card default box-shadow",
      "Do not break existing Button/Badge/Sheet public APIs without aliasing",
      "Do not edit src/modules to consume every new component in this task — happy-dog + Storybook only"
    ],
    "acceptance": [
      "pnpm --filter @e-pig/happy-dog typecheck (or package equivalent) passes",
      "pnpm --filter @e-pig/happy-dog test passes",
      "Storybook builds/starts and lists stories for all P0+P1 components",
      "Sheet supports side bottom + right",
      "Token CSS vars match semantic contract (primary=#495133, background cream)"
    ]
  }
