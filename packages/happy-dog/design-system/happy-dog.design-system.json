        "tagFilter": "full"
      }
    },
    "effects": {
      "figmaPage": { "name": "05 Foundations · Effects", "nodeId": "33:3" },
      "rules": [
        "Shadows express elevation only — never decoration",
        "Product cards default to no shadow",
        "Popover / Dialog / floating actions use Sm → Md → Lg",
        "Keyboard focus always uses Focus/Ring (ring token)"
      ],
      "tokens": ["shadow-sm", "shadow-md", "shadow-lg", "focus-ring"]
    },
    "typography": {
      "note": "Figma MCP did not expose a dedicated Type page node in this extract; use Inter for UI (from component frames) and keep Georgia/serif display from existing happy-dog theme for brand headlines unless DESIGN.md says otherwise.",
      "ui": {
        "family": "Inter",
        "button": { "weight": 600, "sizePx": 13, "tracking": "tight" }
      },
      "display": {
        "family": "Georgia, ui-serif, serif",
        "source": "packages/happy-dog existing theme"
      }
    },
    "controlSizes": {
      "sm": { "heightPx": 32, "cssVar": "--control-sm" },
      "md": { "heightPx": 40, "cssVar": "--control-md" },
      "lg": { "heightPx": 48, "cssVar": "--control-lg" }
    }
