# E-pig 环境变量模板
# 用法：cp .env.example .env.local 后按需修改（.env.local 已被 gitignore，不会入库）。
#
# 设计原则（docs/codex/research/04 §7-8）：
# - 非秘密的市场配置（货币 / locale / host）维护在 src/platform/config/markets.ts，
#   这里只选择"本进程跑哪个市场 / 哪个 adapter"。
# - 秘密值只允许出现在 server 变量里；NEXT_PUBLIC_* 禁止放任何秘密。

# --- 市场选择（本地 / 运行时必填）---
# 必填：au | sg | us。本地 `pnpm dev` 无 MARKET 会直接失败；请用 pnpm dev:au 等。
# 公开 URL 形如 /{MARKET}/collections/...（MUJI 式前缀）；访问其他市场前缀会 308 回本进程市场。
# 新增市场先在 src/platform/config/markets.ts 登记。
MARKET=au

# --- Commerce adapter 选择 ---
# mock 只提供沙箱目录；postgres 才开启持久购物车，交易不使用内存 fallback。
COMMERCE_ADAPTER=mock

# --- After-sales adapter 选择（server-only）---
# mock 保持默认。显式 postgres 时还必须 COMMERCE_ADAPTER=postgres 且 DATABASE_URL 可用；
# 缺条件会安全返回不可用，绝不自动回退 mock。
AFTER_SALES_ADAPTER=mock
# 可选：postgres（需要上面两个条件）
# AFTER_SALES_ADAPTER=postgres

# --- PostgreSQL 驱动（server-only）---
# neon 保持既有部署路径；tcp 只用于 Node 本地/隔离环境。Cloudflare Workers 未声明支持 tcp。
DATABASE_DRIVER=neon
# DATABASE_DRIVER=tcp

# --- 日志级别 ---
# 可选：debug | info | warn | error
LOG_LEVEL=info

# --- 浏览器公开变量（只允许非秘密值）---
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- 持久沙箱交易（永远不要提交真实值，均为 server-only）---
# COMMERCE_ADAPTER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/epig?sslmode=verify-full
# CART_COOKIE_SECRET=至少32字符的随机密钥
# APP_ORIGIN=http://localhost:3000
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Netlify 使用 https://站点名.netlify.app 作为 APP_ORIGIN，并在控制台设置所有秘密值。
# 缺少 Stripe 配置时保留购物车能力，明确关闭付款，不模拟成功。
